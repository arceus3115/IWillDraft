#!/usr/bin/env bash
set -euo pipefail

export LC_ALL=C
patterns="${0%/*}/secret-patterns"

# Keep these paths in sync with the credential entries in .gitignore.
is_credential_path() {
    case "/$1" in
        */.aws/*|*/.ssh/*|*/.secrets/*) return 0 ;;
        */.env.example|*/.dev.vars.example) return 1 ;;
        */.env|*/.env.*|*/.envrc|*/.dev.vars|*/.dev.vars.*|*/.netrc|*/_netrc|*/.npmrc.local|\
        */credentials.json|*/service-account*.json|*/id_rsa|*/id_ed25519|\
        *.key|*.pem|*.p12|*.pfx) return 0 ;;
        *) return 1 ;;
    esac
}

scan_paths() {
    local path status failed=0

    while IFS= read -r -d '' path; do
        if is_credential_path "$path"; then
            printf 'Credential file blocked: %q\n' "$path" >&2
            failed=1
            continue
        fi

        if git grep --cached --no-textconv --no-recurse-submodules -aqEf "$patterns" -- ":(top,literal)$path"; then
            printf 'Possible secret blocked: %q\n' "$path" >&2
            failed=1
        else
            status=$?
            if (( status != 1 )); then
                return "$status"
            fi
        fi
    done

    return "$failed"
}

case "${1:-}" in
    '') git diff --cached --name-only --diff-filter=ACMRT -z | scan_paths ;;
    --all) git ls-files --cached -z | scan_paths ;;
    *) printf 'Usage: %s [--all]\n' "$0" >&2; exit 2 ;;
esac
